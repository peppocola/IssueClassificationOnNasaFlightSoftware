# Example environment file for NASA Issue Classification project
# Copy this file to .env and fill in your actual API keys

# Weights & Biases API Key (required for model tracking)
# Get your key from https://wandb.ai/
WANDB_API_KEY=your-wandb-api-key-here

# OpenAI API Key (optional, only needed for LLM models)
# Get your key from https://platform.openai.com/
OPENAI_API_KEY=your-openai-api-key-here
